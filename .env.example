# Local development. Vercel values belong in Project Settings > Environment Variables.
# Generate a production secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins for custom domains (no trailing slash).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty to use SQLite locally. Required PostgreSQL URL on Vercel.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Optional S3-compatible storage; required before uploading project covers on Vercel.
# Leave the bucket empty for local media storage during development.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
# For Cloudflare R2: https://ACCOUNT_ID.r2.cloudflarestorage.com and region "auto".
AWS_S3_ENDPOINT_URL=
# Optional public media hostname, without https:// or a trailing slash.
AWS_S3_CUSTOM_DOMAIN=
